<%- include('../partials/head') %>
  </head>
  <body class="bg-gray-50 min-h-screen text-gray-800 flex flex-col">
    <%- include('../partials/nav') %>

    <main class="container mx-auto px-4 py-12 flex-1 flex items-center justify-center">
      <div class="bg-white rounded-xl border border-gray-200 p-6 sm:p-8 max-w-md w-full shadow-sm">
        
        <div class="text-center mb-6">
          <div class="w-12 h-12 bg-red-50 text-red-500 rounded-full flex items-center justify-center mx-auto mb-3 text-xl">
            <i class="fa-solid fa-arrow-right-to-bracket"></i>
          </div>
          <h1 class="text-2xl font-bold text-gray-900">Welcome Back</h1>
          <p class="text-xs text-gray-500 mt-1">Sign in with your email to continue</p>
        </div>

        <%- include('../partials/errors') %>

        <form action="/login" method="POST" class="space-y-4">
          <!-- Email field -->
          <div>
            <label for="email" class="block text-xs font-semibold text-gray-700 mb-1">
              Email Address
            </label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-gray-400 text-xs">
                <i class="fa-solid fa-envelope"></i>
              </span>
              <input
                type="email"
                id="email"
                name="email"
                placeholder="name@example.com"
                value="<%= oldInput && oldInput.email ? oldInput.email : '' %>"
                class="w-full pl-8 pr-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500 transition"
                required />
            </div>
          </div>

          <!-- Password field -->
          <div>
            <label for="password" class="block text-xs font-semibold text-gray-700 mb-1">
              Password
            </label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-gray-400 text-xs">
                <i class="fa-solid fa-lock"></i>
              </span>
              <input
                type="password"
                id="password"
                name="password"
                placeholder="Enter your password"
                class="w-full pl-8 pr-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500 transition"
                required />
            </div>
          </div>

          <!-- Submit button -->
          <div class="pt-2">
            <button
              type="submit"
              class="w-full bg-red-500 hover:bg-red-600 text-white font-medium py-2.5 px-4 rounded-md transition text-sm shadow-sm flex items-center justify-center gap-2">
              <span>Sign In</span>
              <i class="fa-solid fa-arrow-right text-xs"></i>
            </button>
          </div>

          <!-- Signup link -->
          <p class="text-center text-xs text-gray-500 pt-3 border-t border-gray-100">
            Don't have an account yet?
            <a href="/signup" class="text-red-500 hover:underline font-semibold ml-1">Create an account</a>
          </p>
        </form>
      </div>
    </main>

    <footer class="bg-white border-t border-gray-200 py-6 mt-auto text-center text-xs text-gray-500">
      <p>&copy; <%= new Date().getFullYear() %> Airbnb Practice Project.</p>
    </footer>
  </body>
</html>
