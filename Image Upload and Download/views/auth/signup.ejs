<%- include('../partials/head') %>
  </head>
  <body class="bg-gray-50 min-h-screen text-gray-800 flex flex-col">
    <%- include('../partials/nav') %>

    <main class="container mx-auto px-4 py-8 flex-1 flex items-center justify-center">
      <div class="bg-white rounded-xl border border-gray-200 p-6 sm:p-8 max-w-md w-full shadow-sm">
        
        <div class="text-center mb-6">
          <div class="w-12 h-12 bg-red-50 text-red-500 rounded-full flex items-center justify-center mx-auto mb-3 text-xl">
            <i class="fa-solid fa-user-plus"></i>
          </div>
          <h1 class="text-2xl font-bold text-gray-900">Create an Account</h1>
          <p class="text-xs text-gray-500 mt-1">Join Airbnb to book stays or list your properties</p>
        </div>

        <%- include('../partials/errors') %>

        <form action="/signup" method="POST" class="space-y-4">
          <!-- Name Fields -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label for="firstName" class="block text-xs font-semibold text-gray-700 mb-1">
                First Name <span class="text-red-500">*</span>
              </label>
              <div class="relative">
                <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-gray-400 text-xs">
                  <i class="fa-solid fa-user"></i>
                </span>
                <input
                  type="text"
                  id="firstName"
                  name="firstName"
                  placeholder="Rahul"
                  value="<%= oldInput.firstName ? oldInput.firstName : '' %>"
                  class="w-full pl-8 pr-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500 transition"
                  required />
              </div>
            </div>

            <div>
              <label for="lastName" class="block text-xs font-semibold text-gray-700 mb-1">
                Last Name
              </label>
              <div class="relative">
                <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-gray-400 text-xs">
                  <i class="fa-solid fa-user"></i>
                </span>
                <input
                  type="text"
                  id="lastName"
                  name="lastName"
                  placeholder="Sharma"
                  value="<%= oldInput.lastName ? oldInput.lastName : '' %>"
                  class="w-full pl-8 pr-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500 transition" />
              </div>
            </div>
          </div>

          <!-- Email -->
          <div>
            <label for="email" class="block text-xs font-semibold text-gray-700 mb-1">
              Email Address <span class="text-red-500">*</span>
            </label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-gray-400 text-xs">
                <i class="fa-solid fa-envelope"></i>
              </span>
              <input
                type="email"
                id="email"
                name="email"
                placeholder="name@example.com"
                value="<%= oldInput.email ? oldInput.email : '' %>"
                class="w-full pl-8 pr-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500 transition"
                required />
            </div>
          </div>

          <!-- Password -->
          <div>
            <label for="password" class="block text-xs font-semibold text-gray-700 mb-1">
              Password <span class="text-red-500">*</span>
            </label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-gray-400 text-xs">
                <i class="fa-solid fa-lock"></i>
              </span>
              <input
                type="password"
                id="password"
                name="password"
                placeholder="At least 6 chars (A-Z, a-z, 0-9, symbol)"
                class="w-full pl-8 pr-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500 transition"
                required />
            </div>
          </div>

          <!-- Confirm Password -->
          <div>
            <label for="confirmPassword" class="block text-xs font-semibold text-gray-700 mb-1">
              Confirm Password <span class="text-red-500">*</span>
            </label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-gray-400 text-xs">
                <i class="fa-solid fa-lock"></i>
              </span>
              <input
                type="password"
                id="confirmPassword"
                name="confirmPassword"
                placeholder="Re-enter your password"
                class="w-full pl-8 pr-3 py-2 text-sm border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-red-500 transition"
                required />
            </div>
          </div>

          <!-- Account Type Radio Selection -->
          <div class="p-3 bg-gray-50 rounded-lg border border-gray-200">
            <span class="block text-xs font-semibold text-gray-700 mb-2">I want to register as:</span>
            <div class="flex items-center gap-6">
              <label class="inline-flex items-center text-sm cursor-pointer text-gray-700">
                <input
                  type="radio"
                  name="userType"
                  value="guest"
                  id="guest"
                  class="text-red-500 focus:ring-red-500 mr-2"
                  <%= (!oldInput.userType || oldInput.userType === 'guest') ? 'checked' : '' %> />
                <span>Guest (Traveler)</span>
              </label>

              <label class="inline-flex items-center text-sm cursor-pointer text-gray-700">
                <input
                  type="radio"
                  name="userType"
                  value="host"
                  id="host"
                  class="text-red-500 focus:ring-red-500 mr-2"
                  <%= oldInput.userType === 'host' ? 'checked' : '' %> />
                <span>Host (Property Owner)</span>
              </label>
            </div>
          </div>

          <!-- Terms -->
          <div class="flex items-start gap-2 pt-1">
            <input
              type="checkbox"
              name="terms"
              id="terms"
              class="mt-1 text-red-500 focus:ring-red-500 rounded border-gray-300"
              required />
            <label for="terms" class="text-xs text-gray-600 cursor-pointer">
              I agree to the Airbnb practice terms and conditions
            </label>
          </div>

          <!-- Submit -->
          <div class="pt-2">
            <button
              type="submit"
              class="w-full bg-red-500 hover:bg-red-600 text-white font-medium py-2.5 px-4 rounded-md transition text-sm shadow-sm flex items-center justify-center gap-2">
              <span>Sign Up</span>
              <i class="fa-solid fa-arrow-right text-xs"></i>
            </button>
          </div>

          <!-- Login Link -->
          <p class="text-center text-xs text-gray-500 pt-3 border-t border-gray-100">
            Already have an account?
            <a href="/login" class="text-red-500 hover:underline font-semibold ml-1">Login here</a>
          </p>
        </form>
      </div>
    </main>

    <footer class="bg-white border-t border-gray-200 py-6 mt-auto text-center text-xs text-gray-500">
      <p>&copy; <%= new Date().getFullYear() %> Airbnb Practice Project.</p>
    </footer>
  </body>
</html>
