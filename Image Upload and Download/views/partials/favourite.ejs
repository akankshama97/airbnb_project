<form action="/favourites" method="POST" class="inline">
  <input type="hidden" name="id" value="<%= home._id %>" />
  <button
    type="submit"
    title="Save to favourites"
    class="inline-flex items-center gap-1 px-2.5 py-1.5 text-xs font-medium text-rose-600 bg-rose-50 hover:bg-rose-100 rounded border border-rose-200 transition">
    <i class="fa-regular fa-heart"></i>
    <span>Save</span>
  </button>
</form>
