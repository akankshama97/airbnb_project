<%- include('../partials/head') %>
  </head>
  <body class="bg-gray-50 min-h-screen text-gray-800 flex flex-col">
    <%- include('../partials/nav') %>

    <main class="container mx-auto max-w-6xl px-4 py-8 flex-1">
      <div class="mb-6">
        <h1 class="text-2xl font-bold text-gray-800">
          All Registered Homes
        </h1>
        <p class="text-sm text-gray-500">
          Browse through all verified places to stay
        </p>
      </div>

      <% if (registeredHomes && registeredHomes.length > 0) { %>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
          <% registeredHomes.forEach(home => { %>
            <% const photoUrl = home.photo ? (home.photo.startsWith('/') ? home.photo : '/' + home.photo.replace(/\\/g, '/')) : '/images/house1.jpg'; %>
            <div class="bg-white rounded-xl border border-gray-200 overflow-hidden shadow-sm hover:shadow-md transition duration-200 flex flex-col">
              
              <!-- Image Container -->
              <div class="relative w-full h-48 bg-gray-100">
                <img
                  src="<%= photoUrl %>"
                  alt="<%= home.houseName %>"
                  class="w-full h-full object-cover"
                  onerror="this.src='/images/house1.jpg'" />
                <div class="absolute top-2 right-2 bg-white bg-opacity-90 px-2 py-0.5 rounded-md text-xs font-semibold text-gray-700 flex items-center gap-1 shadow-sm">
                  <i class="fa-solid fa-star text-amber-500"></i>
                  <span><%= home.rating %></span>
                </div>
              </div>

              <!-- Content -->
              <div class="p-4 flex-1 flex flex-col justify-between">
                <div>
                  <h3 class="font-bold text-gray-800 text-base line-clamp-1 mb-1">
                    <%= home.houseName %>
                  </h3>
                  <p class="text-xs text-gray-500 flex items-center gap-1 mb-3">
                    <i class="fa-solid fa-location-dot text-red-500"></i>
                    <span><%= home.location %></span>
                  </p>
                  <p class="text-sm font-semibold text-gray-900 mb-4">
                    ₹<%= home.price.toLocaleString('en-IN') %> <span class="text-xs font-normal text-gray-500">/ night</span>
                  </p>
                </div>

                <!-- Actions -->
                <div class="pt-2 border-t border-gray-100 flex items-center justify-between gap-2">
                  <a
                    href="/homes/<%= home._id %>"
                    class="flex-1 text-center bg-gray-100 hover:bg-gray-200 text-gray-800 text-xs font-medium py-2 px-3 rounded-md transition">
                    View Details
                  </a>

                  <% if (isLoggedIn && user && user.userType === 'guest') { %>
                    <%- include('../partials/favourite', { home: home }) %>
                  <% } %>
                </div>
              </div>

            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="bg-white border border-gray-200 rounded-xl p-10 text-center max-w-md mx-auto my-12">
          <i class="fa-solid fa-house-chimney-crack text-4xl text-gray-400 mb-3"></i>
          <h3 class="text-lg font-bold text-gray-700 mb-1">No homes found</h3>
          <p class="text-sm text-gray-500 mb-4">Check back soon or explore later.</p>
          <a href="/" class="text-sm text-red-500 hover:underline">Back to Home</a>
        </div>
      <% } %>
    </main>

    <footer class="bg-white border-t border-gray-200 py-6 mt-auto text-center text-xs text-gray-500">
      <p>&copy; <%= new Date().getFullYear() %> Airbnb Practice Project.</p>
    </footer>
  </body>
</html>
