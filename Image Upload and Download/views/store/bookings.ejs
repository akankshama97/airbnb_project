<%- include('../partials/head') %>
  </head>
  <body class="bg-gray-50 min-h-screen text-gray-800 flex flex-col">
    <%- include('../partials/nav') %>

    <main class="container mx-auto max-w-4xl px-4 py-10 flex-1">
      <div class="mb-6">
        <h1 class="text-2xl font-bold text-gray-800">
          My Bookings
        </h1>
        <p class="text-sm text-gray-500">
          Track and manage your upcoming reservations
        </p>
      </div>

      <div class="bg-white rounded-xl border border-gray-200 p-10 text-center shadow-sm">
        <div class="w-16 h-16 bg-red-50 text-red-500 rounded-full flex items-center justify-center mx-auto mb-4 text-2xl">
          <i class="fa-regular fa-calendar-check"></i>
        </div>
        <h2 class="text-xl font-bold text-gray-800 mb-2">No active bookings yet</h2>
        <p class="text-sm text-gray-500 max-w-md mx-auto mb-6">
          When you book a stay, your reservation confirmation and check-in details will show up right here.
        </p>
        <a
          href="/homes"
          class="inline-block bg-red-500 hover:bg-red-600 text-white text-sm font-medium py-2.5 px-6 rounded-md transition shadow-sm">
          Browse Stays
        </a>
      </div>
    </main>

    <footer class="bg-white border-t border-gray-200 py-6 mt-auto text-center text-xs text-gray-500">
      <p>&copy; <%= new Date().getFullYear() %> Airbnb Practice Project.</p>
    </footer>
  </body>
</html>
