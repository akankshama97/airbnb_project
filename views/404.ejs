<%- include('partials/head') %>
  </head>
  <body class="bg-gray-50 min-h-screen text-gray-800 flex flex-col">
    <%- include('partials/nav') %>

    <main class="container mx-auto max-w-md px-4 py-16 flex-1 text-center">
      <div class="w-16 h-16 bg-red-50 text-red-500 rounded-full flex items-center justify-center mx-auto mb-4 text-3xl">
        <i class="fa-solid fa-triangle-exclamation"></i>
      </div>
      <h1 class="text-5xl font-extrabold text-red-500 mb-2">404</h1>
      <h2 class="text-xl font-bold text-gray-800 mb-2">Page Not Found</h2>
      <p class="text-sm text-gray-500 mb-6">
        The page you are looking for does not exist or may have been moved.
      </p>
      <a
        href="/"
        class="inline-block bg-red-500 hover:bg-red-600 text-white text-sm font-medium py-2.5 px-6 rounded-md transition shadow-sm">
        Back to Home
      </a>
    </main>

    <footer class="bg-white border-t border-gray-200 py-6 mt-auto text-center text-xs text-gray-500">
      <p>&copy; <%= new Date().getFullYear() %> Airbnb Practice Project.</p>
    </footer>
  </body>
</html>
